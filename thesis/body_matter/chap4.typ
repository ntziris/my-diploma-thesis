    font-size: 8pt,
    ```move
    let artist = artwork.artist();
    let royalty_amount =
        if (listing.seller == artist) 0 else royalty_of(total, params.royalty_bps());
    let seller_amount = total - royalty_amount;
    if (royalty_amount > 0) {
        transfer::public_transfer(payment.split(royalty_amount, ctx), artist);
    };
    if (payment.value() > 0) {
        transfer::public_transfer(payment, listing.seller);
    } else {
        payment.destroy_zero();
    };
    // ...
    stats.sale(artist, total, royalty_amount);
    fraction::deliver(fraction::from_shares(bought, ctx), buyer);
    ```,
)

*Το πρότυπο εμφάνισης στο wallet.* Ένα wallet δεν γνωρίζει εκ των προτέρων πώς να προβάλει ένα
αντικείμενο τύπου `Fraction`. Το SUI το λύνει με το Object Display @SuiObjectDisplay. Ο εκδότης του
πακέτου δηλώνει ένα πρότυπο εμφάνισης για τον τύπο `Fraction`. Το πρότυπο λέει ποιο πεδίο του
αντικειμένου είναι το όνομα, ποιο η περιγραφή και ποιο η εικόνα, με θέσεις σε αγκύλες που κάθε
wallet ή explorer αντικαθιστά με τα πεδία του συγκεκριμένου αντικειμένου. Ο @code-display δίνει το
πρότυπο του κλάσματος. Η εικόνα είναι η διεύθυνση του aggregator του Walrus με το αναγνωριστικό του
blob, οπότε το wallet κατεβάζει τη δημόσια εικόνα του έργου τέχνης απευθείας από το Walrus, χωρίς
server της εφαρμογής. Ο σύνδεσμος οδηγεί στη σελίδα του έργου τέχνης στο Walrus Site.

Δύο ιδιότητες του προτύπου επηρέασαν το μοντέλο των αντικειμένων. Πρώτον, το πρότυπο αντικαθιστά
μόνο πεδία του ίδιου του αντικειμένου, όχι αντικειμένων στα οποία αυτό δείχνει. Γι' αυτό το κλάσμα
κρατά αντίγραφο του τίτλου και του αναγνωριστικού της εικόνας, όπως είδαμε στην ενότητα #sec(
    <sec-data-model>,
). Δεύτερον, το πρότυπο καταχωρίζεται ως shared αντικείμενο στο κεντρικό Display Registry του SUI
(`0xd`), ενώ το δικαίωμα διαχείρισης (`DisplayCap`) ανήκει στην αρχή. Η αλλαγή του aggregator ή της
διεύθυνσης του site είναι επομένως μία συναλλαγή της ρυθμιστικής αρχής με το capability της, χωρίς
να επηρεαστεί κανένα εκδοθέν κλάσμα. Το αποτέλεσμα στο Slush φαίνεται στο @fig-uc-fractions-wallet,
όπου το κουμπί αποστολής είναι απενεργοποιημένο λόγω έλλειψης του `store`.

