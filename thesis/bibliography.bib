@incollection{TokenizationFineArts2024,
    title        = {Tokenization of Fine Arts: Revolutionizing the Fine Arts Industry with Blockchain},
    author       = {Bhandare, Teesta and Kandi, Mohamed Ali},
    year         = {2024},
    month        = {Mar},
    booktitle    = {Blockchain and Smart-Contract Technologies for Innovative Applications},
    publisher    = {Springer},
    pages        = {167--187},
    doi          = {10.1007/978-3-031-50028-2_6},
    editor       = {El Madhoun, Nour and Dionysiou, Ioanna and Bertin, Emmanuel},
    address      = {Cham},
    abstract     = {
        This chapter analyzes the scope of possibility for tokenizing proof of ownership, evidence
        of valuation, and quality of alternative investment classes that are tangible in nature.
