@article{Fincham2023,
    title        = {Art, Antiquities, and Money Laundering},
    author       = {Fincham, Derek},
    year         = {2023},
    journal      = {Kentucky Law Journal},
    volume       = {111},
    pages        = {309--344},
    url          = {https://ssrn.com/abstract=4336668},
    abstract     = {
        The art and antiquities market is susceptible to money laundering due to traditionally lax
