@article{blackshear2020resources,
    author       = {
        Blackshear, Sam and Dill, David L. and Qadeer, Shaz and Barrett, Clark W. and Mitchell,
        John C. and Padon, Oded and Zohar, Yoni
    },
    title        = {Resources: A Safe Language Abstraction for Money},
    journal      = {arXiv preprint arXiv:2004.05106},
    year         = {2020},
    url          = {https://arxiv.org/abs/2004.05106},
    abstract     = {
        Presents flexible and reliable abstractions for programming with digital currency in the
        Move language. Move uses novel linear resource types: when a resource value is assigned to
        a new memory location, the location previously holding it must be invalidated, and a
        resource type can only be created or destroyed by procedures inside its declaring module.
        The paper presents an executable bytecode language with resources and proves that it enjoys
        resource safety, a conservation property analogous to conservation of mass.
    },
    urldate      = {2026-10-01},
}

