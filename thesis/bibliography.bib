    organization = {Swinburne University of Technology, Blockchain Innovation Centre},
    abstract     = {
        Blockchain is an emerging technology that has the potential to revolutionize the global
        industry and create a trusted relationship in a multi-party business network. In this paper,
        we present ArtChain, an integrated trading system based on blockchain for the art industry.
        It provides a transparent yet privacy-preserving, and tamper-proof transaction history for
        registration, provenance, and traceability of art assets.
    }
}

